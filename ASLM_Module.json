{
    "fileVersion": 2,
    "id": "aslm-chat",
    "name": "ASLM Chat",
    "description": "ASLM Chat Module",
    "version": "0.9.1.4",
    "author": "NEXTGGTECH",
    "type": "ui",
    "category": [
        "text-generation"
    ],
    "hasPage": true,
    "icon": "icon.png",
    "sidebarIcon": "sidebar_icon.png",
    "source": {
        "type": "github",
        "repo": "NEXTGGTECH/ASLM-Chat"
    },
    "supportedPlatforms": [
        {
            "os": "windows",
            "arch": "amd64",
            "key": "windows-amd64"
        },
        {
            "os": "windows",
            "arch": "arm64",
            "key": "windows-arm64"
        },
        {
            "os": "macos",
            "arch": "amd64",
            "key": "macos-amd64"
        },
        {
            "os": "macos",
            "arch": "arm64",
            "key": "macos-arm64"
        }
    ],
    "update": {
        "mode": "release",
        "channel": "release",
        "branch": "main",
        "preserve": [
            "Data/downloads_bridge_cache",
            "Data/model_capabilities",
            "Data/venvs",
            "Settings/settings.json",
            "Skills",
            "MCP/mcp.json",
            "Tools/mcp-web-search/models",
            "db.sqlite3"
        ],
        "runFirstRunAfterUpdate": true
    },
    "dependencies": {
        "engines": [
            {
                "id": "python-runtime",
                "libraries": [
                    "virtualenv"
                ]
            },
            {
                "id": "ollama-service"
            }
        ]
    },
    "commands": {
        "firstRun": [
            {
                "name": "First Run Setup",
                "engine": "python-runtime",
                "exec": "main.py first_run"
            }
        ],
        "run": [
            {
                "name": "UI Server",
                "engine": "python-runtime",
                "exec": "main.py runserver"
            },
            {
                "name": "Ollama Runtime",
                "engine": "python-runtime",
                "exec": "main.py ollama_runtime --log"
            }
        ]
    },
    "settingCategories": [
        {
            "id": "engines",
            "name": "Engines"
        },
        {
            "id": "browser-agent",
            "name": "Browser Agent"
        },
        {
            "id": "sandbox",
            "name": "Sandbox"
        },
        {
            "id": "web-search",
            "name": "WebSearch"
        },
        {
            "id": "web-search-engines",
            "name": "WebSearch Engines"
        },
        {
            "id": "web-search-api",
            "name": "WebSearch API"
        },
        {
            "id": "web-search-search",
            "name": "WebSearch Search"
        },
        {
            "id": "web-search-extraction",
            "name": "WebSearch Extraction"
        },
        {
            "id": "web-search-cache",
            "name": "WebSearch Cache"
        }
    ],
    "settings": [
        {
            "key": "ui-port",
            "type": "port",
            "default": 20000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ui-port",
            "setExec": "main.py set_setting --key ui-port --value {value}"
        },
        {
            "key": "aslm-host-theme",
            "type": "theme",
            "engine": "python-runtime",
            "setExec": "main.py apply_aslm_host_theme --file {value}"
        },
        {
            "key": "aslm-host-locale",
            "type": "locale",
            "engine": "python-runtime",
            "setExec": "main.py apply_aslm_locale --file {value}"
        },
        {
            "key": "key-aslm",
            "type": "key-aslm",
            "engine": "python-runtime",
            "setExec": "main.py set_setting --key key-aslm --value {value}"
        },
        {
            "key": "key-gh",
            "type": "key-gh",
            "engine": "python-runtime",
            "setExec": "main.py set_setting --key key-gh --value {value}"
        },
        {
            "key": "ollama-service_port",
            "type": "port",
            "default": 20003,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_port",
            "setExec": "main.py set_setting --key ollama-service_port --value {value}"
        },
        {
            "key": "browser-daemon-port",
            "type": "port",
            "default": 20010,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key browser-daemon-port",
            "setExec": "main.py set_setting --key browser-daemon-port --value {value}"
        },
        {
            "key": "generate-chat-titles",
            "name": "Generate Chat Titles",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key generate-chat-titles",
            "setExec": "main.py set_setting --key generate-chat-titles --value {value}"
        },
        {
            "key": "console_log_level",
            "name": "Console Log Level",
            "type": "select",
            "default": "debug",
            "allowedValues": [
                "basic",
                "debug",
                "trace"
            ],
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key console_log_level",
            "setExec": "main.py set_setting --key console_log_level --value {value}"
        },
        {
            "key": "llm-engine",
            "name": "Active LLM Engine",
            "type": "select",
            "default": "ollama-service",
            "allowedValues": [
                "ollama-service",
                "lms",
                "openai",
                "google-genai"
            ],
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key llm-engine",
            "setExec": "main.py set_setting --key llm-engine --value {value}",
            "value": "ollama-service",
            "category": "engines"
        },
        {
            "key": "ollama-service",
            "name": "Ollama",
            "type": "engine",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service",
            "setExec": "main.py set_setting --key ollama-service --value {value}",
            "category": "engines"
        },
        {
            "key": "ollama-service_path",
            "name": "Use custom Ollama path",
            "type": "path",
            "default": null,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_path",
            "setExec": "main.py set_setting --key ollama-service_path --value {value}",
            "category": "engines"
        },
        {
            "key": "ollama-service_data",
            "name": "Use custom Ollama data path",
            "type": "data",
            "default": null,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_data",
            "setExec": "main.py set_setting --key ollama-service_data --value {value}",
            "category": "engines"
        },
        {
            "key": "ollama-service_models",
            "name": "Use custom Ollama models path",
            "type": "models",
            "default": null,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_models",
            "setExec": "main.py set_setting --key ollama-service_models --value {value}",
            "category": "engines"
        },
        {
            "key": "lms",
            "name": "LM Studio",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key lms",
            "setExec": "main.py set_setting --key lms --value {value}",
            "category": "engines"
        },
        {
            "key": "lms_url",
            "name": "LM Studio Server URL",
            "type": "string",
            "default": "127.0.0.1:1234",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key lms_url",
            "setExec": "main.py set_setting --key lms_url --value {value}",
            "value": "127.0.0.1:1234",
            "category": "engines",
            "dependsOn": "lms"
        },
        {
            "key": "openai",
            "name": "OpenAI-Compatible API",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key openai",
            "setExec": "main.py set_setting --key openai --value {value}",
            "category": "engines"
        },
        {
            "key": "openai_url",
            "name": "OpenAI-Compatible URL",
            "type": "string",
            "default": "127.0.0.1:1234/v1",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key openai_url",
            "setExec": "main.py set_setting --key openai_url --value {value}",
            "value": "127.0.0.1:1234/v1",
            "category": "engines",
            "dependsOn": "openai"
        },
        {
            "key": "openai_api_key",
            "name": "OpenAI-Compatible API Key (optional)",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key openai_api_key",
            "setExec": "main.py set_setting --key openai_api_key --value {value}",
            "category": "engines",
            "dependsOn": "openai"
        },
        {
            "key": "google-genai",
            "name": "Google GenAI API",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key google-genai",
            "setExec": "main.py set_setting --key google-genai --value {value}",
            "category": "engines"
        },
        {
            "key": "google_genai_url",
            "name": "Google GenAI API URL",
            "type": "string",
            "default": "generativelanguage.googleapis.com",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key google_genai_url",
            "setExec": "main.py set_setting --key google_genai_url --value {value}",
            "category": "engines",
            "dependsOn": "google-genai"
        },
        {
            "key": "google_genai_api_key",
            "name": "Google GenAI API Key",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key google_genai_api_key",
            "setExec": "main.py set_setting --key google_genai_api_key --value {value}",
            "category": "engines",
            "dependsOn": "google-genai"
        },
        {
            "key": "web-search-tavily-api-key",
            "name": "Tavily API Key (optional)",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-tavily-api-key",
            "setExec": "main.py set_setting --key web-search-tavily-api-key --value {value}",
            "category": "web-search-api"
        },
        {
            "key": "web-search-firecrawl-api-key",
            "name": "Firecrawl API Key (optional)",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-firecrawl-api-key",
            "setExec": "main.py set_setting --key web-search-firecrawl-api-key --value {value}",
            "category": "web-search-api"
        },
        {
            "key": "web-search-brave-api-key",
            "name": "Brave Search API Key (optional)",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-brave-api-key",
            "setExec": "main.py set_setting --key web-search-brave-api-key --value {value}",
            "category": "web-search-api"
        },
        {
            "key": "web-search-serpapi-api-key",
            "name": "SerpApi API Key (optional)",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-serpapi-api-key",
            "setExec": "main.py set_setting --key web-search-serpapi-api-key --value {value}",
            "category": "web-search-api"
        },
        {
            "key": "web-search-max-results",
            "name": "Maximum search results",
            "type": "int",
            "default": 10,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-max-results",
            "setExec": "main.py set_setting --key web-search-max-results --value {value}",
            "category": "web-search-search"
        },
        {
            "key": "web-search-total-context-budget",
            "name": "Total search context budget",
            "type": "int",
            "default": 40000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-total-context-budget",
            "setExec": "main.py set_setting --key web-search-total-context-budget --value {value}",
            "category": "web-search-search"
        },
        {
            "key": "web-search-prefetch-timeout",
            "name": "Prefetch timeout",
            "type": "number",
            "default": 8,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-prefetch-timeout",
            "setExec": "main.py set_setting --key web-search-prefetch-timeout --value {value}",
            "category": "web-search-search"
        },
        {
            "key": "web-search-preview-max-chars",
            "name": "Maximum preview length",
            "type": "int",
            "default": 4000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-preview-max-chars",
            "setExec": "main.py set_setting --key web-search-preview-max-chars --value {value}",
            "category": "web-search-search"
        },
        {
            "key": "web-search-extraction-timeout",
            "name": "Extraction timeout",
            "type": "number",
            "default": 25,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-extraction-timeout",
            "setExec": "main.py set_setting --key web-search-extraction-timeout --value {value}",
            "category": "web-search-extraction"
        },
        {
            "key": "web-search-max-page-chars",
            "name": "Maximum page length",
            "type": "int",
            "default": 20000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-max-page-chars",
            "setExec": "main.py set_setting --key web-search-max-page-chars --value {value}",
            "category": "web-search-extraction"
        },
        {
            "key": "web-search-min-content-length",
            "name": "Minimum content length",
            "type": "int",
            "default": 800,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-min-content-length",
            "setExec": "main.py set_setting --key web-search-min-content-length --value {value}",
            "category": "web-search-extraction"
        },
        {
            "key": "web-search-compress-read-pages",
            "name": "Compress long pages",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-compress-read-pages",
            "setExec": "main.py set_setting --key web-search-compress-read-pages --value {value}",
            "category": "web-search-extraction"
        },
        {
            "key": "web-search-compress-threshold",
            "name": "Compression threshold",
            "type": "int",
            "default": 10000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-compress-threshold",
            "setExec": "main.py set_setting --key web-search-compress-threshold --value {value}",
            "category": "web-search-extraction"
        },
        {
            "key": "web-search-compress-target",
            "name": "Compression target",
            "type": "int",
            "default": 10000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-compress-target",
            "setExec": "main.py set_setting --key web-search-compress-target --value {value}",
            "category": "web-search-extraction"
        },
        {
            "key": "web-search-cache-ttl",
            "name": "Search result cache lifetime",
            "type": "int",
            "default": 21600,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-cache-ttl",
            "setExec": "main.py set_setting --key web-search-cache-ttl --value {value}",
            "category": "web-search-cache"
        },
        {
            "key": "web-search-negative-cache-ttl",
            "name": "Search negative cache lifetime",
            "type": "int",
            "default": 300,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-negative-cache-ttl",
            "setExec": "main.py set_setting --key web-search-negative-cache-ttl --value {value}",
            "category": "web-search-cache"
        },
        {
            "key": "web-search-page-cache-ttl",
            "name": "Page cache lifetime",
            "type": "int",
            "default": 86400,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-page-cache-ttl",
            "setExec": "main.py set_setting --key web-search-page-cache-ttl --value {value}",
            "category": "web-search-cache"
        },
        {
            "key": "web-search-repeat-block-window",
            "name": "Repeat block window",
            "description": "Time in seconds that blocks an identical repeated query",
            "type": "int",
            "default": 30,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-repeat-block-window",
            "setExec": "main.py set_setting --key web-search-repeat-block-window --value {value}",
            "category": "web-search-cache"
        },
        {
            "key": "web-search-seen-source-window",
            "name": "Seen source window",
            "description": "Time in seconds that suppresses recently returned sources",
            "type": "int",
            "default": 30,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-seen-source-window",
            "setExec": "main.py set_setting --key web-search-seen-source-window --value {value}",
            "category": "web-search-cache"
        },
        {
            "key": "web-search-prefetch-max-urls",
            "name": "Maximum URL prefetch results",
            "description": "Maximum result URLs prefetched per search. Zero disables prefetching",
            "type": "int",
            "default": 4,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-prefetch-max-urls",
            "setExec": "main.py set_setting --key web-search-prefetch-max-urls --value {value}",
            "category": "web-search-cache"
        },
        {
            "key": "web-search-tor-enabled",
            "name": "Enable Tor Search",
            "description": "Supported only on Windows and requires running Tor",
            "type": "bool",
            "default": false,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-tor-enabled",
            "setExec": "main.py set_setting --key web-search-tor-enabled --value {value}",
            "category": "web-search"
        },
        {
            "key": "web-search-engine-google",
            "name": "Google",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-engine-google",
            "setExec": "main.py set_setting --key web-search-engine-google --value {value}",
            "category": "web-search-engines"
        },
        {
            "key": "web-search-engine-duckduckgo",
