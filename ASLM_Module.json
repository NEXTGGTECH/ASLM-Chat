            "category": "web-search-engines"
        },
        {
            "key": "web-search-engine-startpage",
            "name": "Startpage",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-engine-startpage",
            "setExec": "main.py set_setting --key web-search-engine-startpage --value {value}",
            "category": "web-search-engines"
        },
        {
            "key": "web-search-engine-qwant",
            "name": "Qwant",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-engine-qwant",
            "setExec": "main.py set_setting --key web-search-engine-qwant --value {value}",
            "category": "web-search-engines"
        },
        {
            "key": "web-search-engine-brave",
            "name": "Brave Search",
            "type": "bool",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-engine-brave",
            "setExec": "main.py set_setting --key web-search-engine-brave --value {value}",
            "category": "web-search-engines"
        },
        {
            "key": "web-search-engine-yandex",
            "name": "Yandex",
            "type": "bool",
            "default": false,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-engine-yandex",
            "setExec": "main.py set_setting --key web-search-engine-yandex --value {value}",
            "category": "web-search-engines"
        },
        {
            "key": "web-search-engine-yep",
            "name": "Yep",
            "type": "bool",
            "default": false,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key web-search-engine-yep",
